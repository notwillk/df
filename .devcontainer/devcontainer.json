{
  "name": "Kaylee",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu26.04",
  "features": {
    "ghcr.io/notwillk/rulesy/rulesy": {}
  },
  "containerEnv": {
    "DEVCONTAINER": "true"
  },
  "remoteEnv": {
    "PATH": "${containerEnv:HOME}/.local/opt/codex-cli/bin:${containerEnv:HOME}/.local/bin:${containerEnv:HOME}/.cargo/bin:${containerEnv:PATH}"
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "github.vscode-github-actions",
        "golang.go",
        "moonrepo.moon-console",
        "sst-dev.opencode"
      ]
    }
  },
  "remoteUser": "vscode"
}
