{
  "name": "Kaylee",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu26.04",
  "features": {
    "ghcr.io/notwillk/rulesy/rulesy": {}
  },
  "containerEnv": {
    "DEVCONTAINER": "true"
  },
  "remoteEnv": {
    "PATH": "/home/vscode/.local/opt/codex-cli/bin:/home/vscode/.local/bin:/home/vscode/.cargo/bin:${containerEnv:PATH}"
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "github.vscode-github-actions",
        "golang.go",
        "moonrepo.moon-console",
        "sst-dev.opencode"
      ]
    }
  },
  "postStartCommand": "/usr/local/bin/rulesy --config=.devcontainer/rulesy.yaml check --non-interactive",
  "remoteUser": "vscode"
}
